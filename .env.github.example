# Copy to .env.github.local. Never use VITE_ prefixes for server credentials.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=.local/github-app.pem
GITHUB_STATE_REPOSITORY=
GITHUB_STATE_BRANCH=dashboard-state
GITHUB_STATE_ALLOW_PUBLIC=false
GITHUB_ALLOWED_USERS=
ACTIVITY_INGEST_KEY=
ACTIVITY_WEB_ORIGIN=http://127.0.0.1:5173
ACTIVITY_PORT=8787
VITE_ACTIVITY_AUTH=github
VITE_ACTIVITY_API_URL=/api
